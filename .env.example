# Local development only. Generate real values for anything shared:
#   openssl rand -base64 32

# 32 bytes, base64. Encrypts request headers/bodies at rest.
SECRETS_KEY=ZGV2LW9ubHktc2VjcmV0cy1rZXktMzItYnl0ZXMhISE=

# Signs and verifies tenant JWTs (HS256).
JWT_SECRET=dev-only-jwt-secret-change-me

MYSQL_ROOT_PASSWORD=root-dev-only
MYSQL_USER=crobat
MYSQL_PASSWORD=crobat-dev-only

# Executor capacity per JVM.
EXECUTOR_WORKERS=32
EXECUTOR_POLL_MS=500

# How long finished jobs stay in the hot table.
ARCHIVE_SUCCEEDED_AFTER_MINUTES=60
ARCHIVE_DEAD_AFTER_HOURS=336
HISTORY_TTL_DAYS=30

# Where the Java server finds the built React files.
# Docker sets this to /app/web; local runs can use frontend/dist.
# WEB_ROOT=frontend/dist

# Echo is bound to port 80 inside its container; 8083 is the host port.
ECHO_PORT=80

# CLI endpoints.
CROBAT_TASK_API=http://localhost:8080
CROBAT_JOB_API=http://localhost:8081
